{
  "name": "fotone-monorepo",
  "version": "0.0.3",
  "license": "MIT",
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/fotone",
  "private": true,
  "publishConfig": {
    "directory": ".publish"
  },
  "type": "module",
  "description": "The fastest one-command static web server in the world.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.7",
    "pnpm": ">=12.18"
  },
  "scripts": {
    "bump": "pnpm -r --include-workspace-root version",
    "lint": "oxlint --fix && biome check --write --unsafe && tsc",
    "fotone": "cargo run --quiet --locked --release --manifest-path packages/fotone-rust/Cargo.toml --",
    "build": "pnpm -F fotone-node build && cargo build --locked --release --manifest-path packages/fotone-rust/Cargo.toml",
    "prepack": "node pack.ts",
    "pretest": "pnpm build",
    "test": "vitest run",
    "prebenchmark": "pnpm build",
    "benchmark": "vitest bench --config test/vitest.config.ts --run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@fastify/static": "^10.1.12",
    "@hono/node-server": "^2.1.11",
    "@types/node": "^26.6.6",
    "autocannon": "9.0.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.21",
    "oxlint": "^1.95.0",
    "oxlint-better": "1.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
