{
  "name": "fotone-node",
  "version": "0.0.4",
  "description": "Production static HTTP server",
  "repository": "https://github.com/damianobarbati/fotone",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fotone-node": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --platform=node --format=esm --target=node24 --external:bcrypt --external:zod --outfile=dist/index.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
